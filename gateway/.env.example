# ==============================================================================
# Cellular WAN Failover Gateway - Environment Configuration
# ==============================================================================

# Network Interfaces
PRIMARY_IFACE=eth0
FAILOVER_IFACE=eth1

# Failover Subnet & Gateway (Router WAN 2 direct link)
FAILOVER_GATEWAY_IP=192.168.100.1
FAILOVER_CIDR=24

# Automatic in-container IP assignment for FAILOVER_IFACE (set false if host manages it)
# NOTE: If true, the container will error out if the interface already has an IP configured.
FAILOVER_AUTO_CONFIGURE_IFACE=true

# Internal DHCP Server (dnsmasq) for Failover Interface
FAILOVER_DHCP_ENABLED=true
FAILOVER_DHCP_RANGE_START=          # Optional. Auto-derived from FAILOVER_GATEWAY_IP if blank (e.g. 192.168.100.10)
FAILOVER_DHCP_RANGE_END=            # Optional. Auto-derived from FAILOVER_GATEWAY_IP if blank (e.g. 192.168.100.20)
FAILOVER_DHCP_LEASE_TIME=12h
FAILOVER_DNS_SERVERS=1.1.1.1,1.0.0.1

# Routing & WireGuard
ROUTING_TABLE_ID=100
WG_IFACE=wg0
CLAMP_MSS=true

# Smartphone Communication
PHONE_IP=                          # Leave blank for UDP auto-discovery (port 8990)
HTTP_PORT=8989
DISCOVERY_PORT=8990

# Health Check & Outage Detection
PING_TARGETS=1.1.1.1 8.8.8.8
PING_TIMEOUT=2
CANARY_IP=198.18.0.1
FAIL_THRESHOLD=3
RESTORE_THRESHOLD=5
CHECK_INTERVAL=5

# Container Settings
CONTAINER_NAME=wan-failover-gateway
GATEWAY_IMAGE=ghcr.io/tichael/cellular-wan-gateway:latest
